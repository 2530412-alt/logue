<?xml version="1.0" encoding="utf-8"?>
<!--
  Solo en la versión debug (la que corre desde Android Studio): permite HTTP sin cifrar para
  llegar al backend local (10.0.2.2, localhost o la IP de la PC en la red). La versión release
  usa src/main/res/xml/network_security_config.xml, que exige HTTPS.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
